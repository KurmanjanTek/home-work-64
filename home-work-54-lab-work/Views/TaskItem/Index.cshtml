@using home_work_54_lab_work.Enums
@model home_work_54_lab_work.ViewModels.TaskIndexViewModel

@{
    ViewData["Title"] = "Index";
}

<form asp-action="Index" method="get">

    <div>
        <label for="name">Название:</label>
        <input type="text" name="name" id="name" />
    </div>

    <div>
        <label for="description">Описание:</label>
        <input type="text" name="description" />
    </div>

    <div>
        <label for="dateFrom">Дата создания от:</label>
        <input type="date" name="dateFrom" />
    </div>

    <div>
        <label for="dateTo">Дата создания до:</label>
        <input type="date" name="dateTo" />
    </div>
    
    <div>
        <label>Приоритет:</label>
        <select name="priority">
            <option value="">Все</option>
            <option value="1">Низкий</option>
            <option value="2">Средний</option>
            <option value="3">Высокий</option>
        </select>
    </div>
    
    <div>
        <label>Статус:</label>
        <select name="status">
            <option value="">Все</option>
            <option value="1">Новая</option>
            <option value="2">Открыта</option>
            <option value="3">Закрыта</option>
        </select>
    </div>

    <button type="submit">Фильтр</button>

</form>

<table class="table">
    <thead>
    <tr>
        <th>
            Номер
        </th>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSort">
                Название задачи
            </a>
        </th>
     
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewBag.PrioritySort">
                Приоритет
            </a>
        </th>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewBag.StatusSort">
                Статус
            </a>
        </th>
        <th>
            <a asp-action="Index" asp-route-sortOrder="@ViewBag.CreatedDateSort">
                Дата создания
            </a>
        </th>
        
        <th>Действия</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.TaskItems) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @switch (item.Prioritety)
                {
                    case Priority.Low:
                        <span>Низкий</span>
                        break;
                    case Priority.Medium:
                        <span>Средний</span>
                        break;
                    case Priority.High:
                        <span>Высокий</span>
                        break;
                }
            </td>
            <td>
                @switch (item.Status)
                {
                    case ToDoStatus.New:
                        <span>Новая</span>
                        break;
                    case ToDoStatus.InProgress:
                        <span>Открыта</span>
                        break;
                    case ToDoStatus.Done:
                        <span>Закрыта</span>
                        break;
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedDate)
            </td>
        
            <td>
                @if (item.Status == ToDoStatus.New)
                {
                    <a asp-action="Open" asp-route-id="@item.Id">Открыть</a> 
                    <a asp-action="Details" asp-route-id="@item.Id">Детали</a> 
                    <a asp-action="Delete" asp-route-id="@item.Id">Удалить</a>
                    <a asp-action="TakeTask" asp-route-id="@item.Id">Взять задачу</a>
                }
                else if (item.Status == ToDoStatus.InProgress)
                {
                    <a asp-action="Close" asp-route-id="@item.Id">Закрыть</a> 
                    <a asp-action="Details" asp-route-id="@item.Id">Детали</a> 
                }
                else if (item.Status == ToDoStatus.Done)
                {
                    <a asp-action="Delete" asp-route-id="@item.Id">Удалить</a>
                    <a asp-action="Details" asp-route-id="@item.Id">Детали</a> 
                }
            </td>
        </tr>
    }
    </tbody>
</table>
@if (Model.PageViewModel.HasPreviousPage)
{
<a asp-action="Index" asp-route-page="@(Model.PageViewModel.PageNumber-1)" class="btn-outline-light">Предыдущая</a>
}
@for (int i = 1; i <= Model.PageViewModel.TotalPages; i++)
{
if (i == Model.PageViewModel.PageNumber)
{
<span class="btn btn-success">@i</span>
}
else
{
<a asp-action="Index" asp-route-page="@i" class="btn-outline-light">@i</a>
}
}
@if (Model.PageViewModel.HasNextPage)
{
<a asp-action="Index" asp-route-page="@(Model.PageViewModel.PageNumber+1)" class="btn-outline-light">Следующая</a>
}

