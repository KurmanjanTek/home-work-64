@using home_work_54_lab_work.Enums
@model home_work_54_lab_work.ViewModels.TaskItemViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>TaskItem</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label">Название задачи</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label">Описание задачи</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Prioritety" class="control-label">Приоритет</label>
                <select asp-for="Prioritety" class="form-control">
                    <option value="1">Низкий</option>
                    <option value="2">Средний</option>
                    <option value="3">Высокий</option>
                </select>
                <span asp-validation-for="Prioritety" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <label asp-for="ExecuterName" class="control-label">Исполнитель</label>
                <input asp-for="ExecuterName" class="form-control" />
                <span asp-validation-for="ExecuterName" class="text-danger"></span>
            </div>
           
          <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
