@model  IEnumerable<TaskItem>

<h3>Мои задачи</h3>

@foreach (var item in Model)
{
    <div>
        <h4>@item.Name</h4>
        <p>Приоритет: @item.Prioritety</p>
        <p>Статус: @item.Status</p>
        <p>Дата создания: @item.CreatedDate</p>
        
        <a asp-action="Details" asp-route-id="@item.Id">Подробнее</a>
    </div>
}